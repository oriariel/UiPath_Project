    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Dim labels As String() = {&quot;שופרסל&quot;, &quot;רמי לוי&quot;, &quot;ויקטורי&quot;}&#xA;Dim tables As System.Data.DataTable() = {dtShufersal, dtRami, dtVictory}&#xA;Dim totals(2) As Double&#xA;Dim found(2) As Integer&#xA;Dim missing(2) As Integer&#xA;Dim active(2) As Boolean&#xA;Dim columnNames As String() = {&quot;שופרסל&quot;, &quot;רמי לוי&quot;, &quot;ויקטורי&quot;}&#xA;dtSummary = New System.Data.DataTable()&#xA;dtSummary.Columns.Add(&quot;מדד&quot;)&#xA;dtSummary.Columns.Add(&quot;שופרסל&quot;)&#xA;dtSummary.Columns.Add(&quot;רמי לוי&quot;)&#xA;dtSummary.Columns.Add(&quot;ויקטורי&quot;)&#xA;For i As Integer = 0 To 2&#xA;    Dim table As System.Data.DataTable = tables(i)&#xA;    If table Is Nothing Then&#xA;        Continue For&#xA;    End If&#xA;    For Each source As System.Data.DataRow In table.Rows&#xA;        Dim status As String = source(&quot;Status&quot;).ToString()&#xA;        If status = &quot;לא נמצא&quot; Then&#xA;            missing(i) += 1&#xA;        Else&#xA;            found(i) += 1&#xA;            Dim line As Double = 0&#xA;            Double.TryParse(source(&quot;LineTotal&quot;).ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, line)&#xA;            totals(i) += line&#xA;        End If&#xA;    Next&#xA;    totals(i) = Math.Round(totals(i), 2, MidpointRounding.AwayFromZero)&#xA;    active(i) = found(i) &gt; 0&#xA;Next&#xA;Dim totalRow = dtSummary.NewRow()&#xA;totalRow(&quot;מדד&quot;) = &quot;סה&quot;&quot;כ הסל&quot;&#xA;Dim foundRow = dtSummary.NewRow()&#xA;foundRow(&quot;מדד&quot;) = &quot;נמצאו&quot;&#xA;Dim missingRow = dtSummary.NewRow()&#xA;missingRow(&quot;מדד&quot;) = &quot;לא נמצאו&quot;&#xA;Dim fairRow = dtSummary.NewRow()&#xA;fairRow(&quot;מדד&quot;) = &quot;סה&quot;&quot;כ השוואה הוגנת&quot;&#xA;For i As Integer = 0 To 2&#xA;    totalRow(columnNames(i)) = If(active(i), totals(i).ToString(&quot;0.00&quot;, CultureInfo.InvariantCulture), &quot;לא דורג&quot;)&#xA;    foundRow(columnNames(i)) = found(i).ToString()&#xA;    missingRow(columnNames(i)) = missing(i).ToString()&#xA;Next&#xA;dtSummary.Rows.Add(totalRow)&#xA;dtSummary.Rows.Add(foundRow)&#xA;dtSummary.Rows.Add(missingRow)&#xA;Dim bestIndex As Integer = -1&#xA;Dim worstIndex As Integer = -1&#xA;For i As Integer = 0 To 2&#xA;    If Not active(i) Then&#xA;        Continue For&#xA;    End If&#xA;    If bestIndex = -1 OrElse totals(i) &lt; totals(bestIndex) Then&#xA;        bestIndex = i&#xA;    End If&#xA;    If worstIndex = -1 OrElse totals(i) &gt; totals(worstIndex) Then&#xA;        worstIndex = i&#xA;    End If&#xA;Next&#xA;Dim cheapRow = dtSummary.NewRow()&#xA;cheapRow(&quot;מדד&quot;) = &quot;הזולה לפי סה&quot;&quot;כ הסל&quot;&#xA;If bestIndex &gt;= 0 Then&#xA;    cheapRow(&quot;שופרסל&quot;) = labels(bestIndex) &amp; &quot; (&quot; &amp; totals(bestIndex).ToString(&quot;0.00&quot;, CultureInfo.InvariantCulture) &amp; &quot;)&quot;&#xA;End If&#xA;dtSummary.Rows.Add(cheapRow)&#xA;Dim dearRow = dtSummary.NewRow()&#xA;dearRow(&quot;מדד&quot;) = &quot;היקרה לפי סה&quot;&quot;כ הסל&quot;&#xA;If worstIndex &gt;= 0 Then&#xA;    dearRow(&quot;שופרסל&quot;) = labels(worstIndex) &amp; &quot; (&quot; &amp; totals(worstIndex).ToString(&quot;0.00&quot;, CultureInfo.InvariantCulture) &amp; &quot;)&quot;&#xA;End If&#xA;dtSummary.Rows.Add(dearRow)&#xA;Dim saveRow = dtSummary.NewRow()&#xA;saveRow(&quot;מדד&quot;) = &quot;חיסכון מול היקרה&quot;&#xA;If bestIndex &gt;= 0 AndAlso worstIndex &gt;= 0 Then&#xA;    saveRow(&quot;שופרסל&quot;) = (totals(worstIndex) - totals(bestIndex)).ToString(&quot;0.00&quot;, CultureInfo.InvariantCulture)&#xA;End If&#xA;dtSummary.Rows.Add(saveRow)&#xA;Dim fairNames As New System.Collections.Generic.List(Of String)&#xA;Dim seed As System.Data.DataTable = Nothing&#xA;For i As Integer = 0 To 2&#xA;    If active(i) Then&#xA;        seed = tables(i)&#xA;        Exit For&#xA;    End If&#xA;Next&#xA;If seed IsNot Nothing Then&#xA;    For Each source As System.Data.DataRow In seed.Rows&#xA;        Dim product As String = source(&quot;RequestedProduct&quot;).ToString()&#xA;        If fairNames.Contains(product) Then&#xA;            Continue For&#xA;        End If&#xA;        Dim inAll As Boolean = True&#xA;        For i As Integer = 0 To 2&#xA;            If Not active(i) Then&#xA;                Continue For&#xA;            End If&#xA;            Dim hit As Boolean = False&#xA;            For Each candidate As System.Data.DataRow In tables(i).Rows&#xA;                If candidate(&quot;RequestedProduct&quot;).ToString() = product AndAlso candidate(&quot;Status&quot;).ToString() &lt;&gt; &quot;לא נמצא&quot; Then&#xA;                    hit = True&#xA;                    Exit For&#xA;                End If&#xA;            Next&#xA;            If Not hit Then&#xA;                inAll = False&#xA;                Exit For&#xA;            End If&#xA;        Next&#xA;        If inAll Then&#xA;            fairNames.Add(product)&#xA;        End If&#xA;    Next&#xA;End If&#xA;Dim fairTotals(2) As Double&#xA;For i As Integer = 0 To 2&#xA;    If Not active(i) Then&#xA;        fairRow(columnNames(i)) = &quot;לא נכללת&quot;&#xA;        Continue For&#xA;    End If&#xA;    For Each source As System.Data.DataRow In tables(i).Rows&#xA;        If fairNames.Contains(source(&quot;RequestedProduct&quot;).ToString()) AndAlso source(&quot;Status&quot;).ToString() &lt;&gt; &quot;לא נמצא&quot; Then&#xA;            Dim line As Double = 0&#xA;            Double.TryParse(source(&quot;LineTotal&quot;).ToString(), NumberStyles.Any, CultureInfo.InvariantCulture, line)&#xA;            fairTotals(i) += line&#xA;        End If&#xA;    Next&#xA;    fairTotals(i) = Math.Round(fairTotals(i), 2, MidpointRounding.AwayFromZero)&#xA;    fairRow(columnNames(i)) = fairTotals(i).ToString(&quot;0.00&quot;, CultureInfo.InvariantCulture)&#xA;Next&#xA;Dim countRow = dtSummary.NewRow()&#xA;countRow(&quot;מדד&quot;) = &quot;מוצרים בהשוואה הוגנת&quot;&#xA;countRow(&quot;שופרסל&quot;) = fairNames.Count.ToString()&#xA;dtSummary.Rows.Add(countRow)&#xA;dtSummary.Rows.Add(fairRow)&#xA;Dim fairBest As Integer = -1&#xA;For i As Integer = 0 To 2&#xA;    If active(i) AndAlso (fairBest = -1 OrElse fairTotals(i) &lt; fairTotals(fairBest)) Then&#xA;        fairBest = i&#xA;    End If&#xA;Next&#xA;Dim fairCheap = dtSummary.NewRow()&#xA;fairCheap(&quot;מדד&quot;) = &quot;הזולה בהשוואה הוגנת&quot;&#xA;If fairBest &gt;= 0 Then&#xA;    fairCheap(&quot;שופרסל&quot;) = labels(fairBest) &amp; &quot; (&quot; &amp; fairTotals(fairBest).ToString(&quot;0.00&quot;, CultureInfo.InvariantCulture) &amp; &quot;)&quot;&#xA;End If&#xA;dtSummary.Rows.Add(fairCheap)&#xA;Dim noteRow = dtSummary.NewRow()&#xA;noteRow(&quot;מדד&quot;) = &quot;הערה&quot;&#xA;noteRow(&quot;שופרסל&quot;) = &quot;סל בלי מוצרים שנמצאו לא נכנס לדירוג. ההשוואה ההוגנת היא רק על מוצרים שנמצאו בכל הרשתות הפעילות.&quot;&#xA;dtSummary.Rows.Add(noteRow)&#xA;" DisplayName="Build comparison summary" sap:VirtualizedContainerService.HintSize="450,403" sap2010:WorkflowViewState.IdRef="InvokeCode_Summary">
